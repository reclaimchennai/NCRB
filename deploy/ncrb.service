[Unit]
Description=NCRB data explorer (ncrb.reclaimchennai.city, cpi.reclaimchennai.city/ncrb)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
WorkingDirectory=%h/projects/ncrb
# 0.0.0.0, not 127.0.0.1: Caddy reaches this through host.docker.internal from a
# separate network namespace, where a loopback-only bind is unreachable.
ExecStart=%h/projects/ncrb/.venv/bin/uvicorn api.site:app \
    --host 0.0.0.0 --port 5072 --workers 2 \
    --proxy-headers --forwarded-allow-ips='*' --log-level warning
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
MemoryMax=2G

[Install]
WantedBy=default.target
